# Environment Variables Example for Aryaa Jaiswal Portfolio

# Web3Forms Access Key (Get a free key in 10s at https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"

# Alternative: Formspree Form ID (https://formspree.io/)
# VITE_FORMSPREE_ID="your_formspree_id"

# Alternative: Custom Webhook URL (Zapier / Make / Discord / Slack / API)
# VITE_WEBHOOK_URL="https://your-webhook-endpoint.com/api"

# Fallback email for direct mailto links
VITE_CONTACT_EMAIL="your_email@example.com"
